{
  "name": "todo",
  "version": "0.1.0",
  "description": "Moku Todo — a Layer-3 Moku consumer demo: an offline todo app on @moku-labs/web (Preact SPA + islands) + @moku-labs/system (store, notifications, clipboard, tray, deep links), packaged for macOS and iOS by @moku-labs/native.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "@moku-labs/system": "file:../../.local-packages/moku-labs-system-0.1.0.tgz",
    "@moku-labs/web": "2.3.2",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "2.3.3",
    "@tauri-apps/plugin-deep-link": "2.4.10",
    "@tauri-apps/plugin-notification": "2.4.0",
    "@tauri-apps/plugin-store": "2.4.5",
    "preact": "10.29.3",
    "preact-render-to-string": "6.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@moku-labs/native": "file:../../.local-packages/moku-labs-native-0.1.0.tgz",
    "@types/bun": "1.3.14",
    "@vitest/coverage-istanbul": "4.0.18",
    "eslint": "9.39.3",
    "eslint-config-biome": "2.1.3",
    "eslint-plugin-jsdoc": "62.6.0",
    "eslint-plugin-sonarjs": "4.0.0",
    "eslint-plugin-unicorn": "63.0.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.4.0",
    "jiti": "2.6.1",
    "lefthook": "2.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.58.0",
    "vitest": "4.0.18"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun scripts/dev.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && eslint .",
    "lint:fix": "biome check --write . && eslint --fix .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --project integration --coverage",
    "native:build:macos": "bun run scripts/native-build-macos.ts",
    "native:build:ios-sim": "bun run scripts/native-build-ios-sim.ts",
    "native:dev": "bun run scripts/native-dev.ts",
    "native:doctor": "bun run scripts/native-doctor.ts",
    "native:clean": "bun run scripts/native-clean.ts"
  }
}
