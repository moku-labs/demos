{
  "name": "merge-game",
  "version": "0.1.0",
  "description": "Moku merge game (Timber Town) \u2014 a Layer-3 demo on @moku-labs/game: the engine's reference puzzle game, its e2e and visual tests, and the editor on it.",
  "private": true,
  "type": "module",
  "moku": {
    "demo": true
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "moku-game dev",
    "build": "moku-game build",
    "keys": "moku-game keys",
    "pack": "moku-game pack",
    "native": "moku-game native",
    "editor": "moku-editor --root .",
    "test": "bun --bun vitest run --project unit --project e2e",
    "test:visual": "moku-game visual",
    "test:editor": "bun --bun vitest run --project editor",
    "test:editor:e2e": "moku-editor e2e -c tests/browser/playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint"
  },
  "dependencies": {
    "@moku-labs/common": "0.3.4",
    "@moku-labs/core": "1.7.1",
    "@moku-labs/game": "0.12.0",
    "@moku-labs/native": "0.3.2",
    "@moku-labs/system": "0.3.1",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-haptics": "2.4.1",
    "pixi.js": "8.21.0"
  },
  "devDependencies": {
    "@moku-labs/editor": "0.9.0",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.3.14",
    "happy-dom": "20.14.5",
    "oxlint": "1.87.0",
    "playwright-core": "1.60.0",
    "preact": "10.29.8",
    "sharp": "0.34.5",
    "typescript": "6.0.3",
    "vitest": "4.0.18"
  }
}
